[
  {
    "name": "示例书源名称",
    "url": "https://example.com",
    "type": 0,
    "enabled": true,
    "searchUrl": "https://example.com/search?q={{key}}",
    "searchRule": {
      "list": ".result-item",
      "name": ".title",
      "author": ".author",
      "cover": ".cover img@src",
      "url": "a@href"
    },
    "detailRule": {
      "name": ".book-title",
      "author": ".book-author",
      "intro": ".book-intro",
      "cover": ".book-cover@src",
      "tocUrl": ".toc-link@href"
    },
    "tocRule": {
      "list": ".chapter-list li",
      "name": "a",
      "url": "a@href"
    },
    "contentRule": {
      "content": ".chapter-content",
      "nextUrl": ".next-chapter@href"
    }
  }
]
